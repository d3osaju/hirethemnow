# ===================================
# PRODUCTION ENVIRONMENT VARIABLES
# ===================================
# Copy this file to .env and fill in your production values
# NEVER commit .env file to version control

# Database Configuration
DATABASE_PASSWORD=example_password123

# JWT Authentication (min 32 characters)
JWT_SECRET=example_jwt_secret_key_at_least_32_characters_long_123456

# Google OAuth (Get from Google Cloud Console)
GOOGLE_CLIENT_ID=123456789-abcdefghijklmnop.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-example_secret_key_here

# AWS S3 Configuration (for resume uploads in production)
# Note: Use IAM roles instead of access keys when possible
AWS_ACCESS_KEY_ID=AKIAEXAMPLEKEY123456
AWS_SECRET_ACCESS_KEY=exampleSecretKey1234567890abcdefghijklmnop
AWS_REGION=us-east-1

# S3 Bucket Configuration
AWS__S3__BucketName=hirethemnow-resumes
